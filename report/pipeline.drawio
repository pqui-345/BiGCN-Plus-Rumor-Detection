<mxfile host="app.diagrams.net" modified="2026-11-05T08:00:00.000Z" agent="Draw.io" version="24.0.0" type="device">
  <diagram id="pipeline-nlp-gnn" name="Pipeline NLP - BiGCN">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Bước 1: Dữ liệu đầu vào -->
        <mxCell id="b1" value="&lt;b&gt;1. Dữ liệu đầu vào (Twitter15 &amp;amp; Twitter16)&lt;/b&gt;&lt;br&gt;• Văn bản bài đăng gốc (source tweet) và các phản hồi&lt;br&gt;• Cây lan truyền có hướng (ai phản hồi/chia sẻ ai kèm thời gian)&lt;br&gt;• Nhãn sự kiện 4 lớp: {NR, FR, TR, UR}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="340" y="40" width="440" height="80" as="geometry" />
        </mxCell>

        <!-- Bước 2: Tiền xử lý NLP & Xây dựng đồ thị -->
        <mxCell id="b2_left" value="&lt;b&gt;2a. Trích xuất đặc trưng văn bản (NLP)&lt;/b&gt;&lt;br&gt;• Tiền xử lý văn bản (tách từ, lọc nhiễu URL/ký tự)&lt;br&gt;• Mã hóa đặc trưng nút X (TF-IDF 5000 chiều hoặc BERT)&lt;br&gt;• Trích xuất riêng véc-tơ nút bài gốc (x_root)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="170" width="420" height="85" as="geometry" />
        </mxCell>

        <mxCell id="b2_right" value="&lt;b&gt;2b. Xây dựng đồ thị kép &amp;amp; Điều chuẩn (Graph Mining)&lt;/b&gt;&lt;br&gt;• Đồ thị lan truyền từ gốc xuống lá Top-Down (A_TD)&lt;br&gt;• Đồ thị hội tụ từ lá lên gốc Bottom-Up (A_BU)&lt;br&gt;• Điều chuẩn DropEdge (ẩn ngẫu nhiên 20% cạnh chống Over-smoothing)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="600" y="170" width="420" height="85" as="geometry" />
        </mxCell>

        <!-- Bước 3: Học biểu diễn đồ thị hai chiều -->
        <mxCell id="b3_left" value="&lt;b&gt;3a. Nhánh lan truyền Top-Down (TD-GCN / GAT)&lt;/b&gt;&lt;br&gt;• Học cấu trúc khuếch đại thông tin từ bài gốc xuống cộng đồng&lt;br&gt;• Tầng GCN 1 + Nối tắt đặc trưng bài gốc (Concat x_root) + Tầng GCN 2&lt;br&gt;• Gộp cấp độ đồ thị: s_TD = GlobalMeanPool(H_TD)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="310" width="420" height="90" as="geometry" />
        </mxCell>

        <mxCell id="b3_right" value="&lt;b&gt;3b. Nhánh hội tụ Bottom-Up (BU-GCN / GAT)&lt;/b&gt;&lt;br&gt;• Học cấu trúc tổng hợp lập trường phản hồi từ cộng đồng về bài gốc&lt;br&gt;• Tầng GCN 1 + Nối tắt đặc trưng bài gốc (Concat x_root) + Tầng GCN 2&lt;br&gt;• Gộp cấp độ đồ thị: s_BU = GlobalMeanPool(H_BU)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="600" y="310" width="420" height="90" as="geometry" />
        </mxCell>

        <!-- Bước 4: Hợp nhất đặc trưng & Phân loại -->
        <mxCell id="b4" value="&lt;b&gt;4. Hợp nhất đặc trưng &amp;amp; Phân loại (Feature Fusion &amp;amp; Classification)&lt;/b&gt;&lt;br&gt;• Hợp nhất hai luồng biểu diễn: s = Concat(s_TD, s_BU)&lt;br&gt;• Đưa qua tầng kết nối đầy đủ (Fully Connected + Softmax), tối ưu bằng hàm mất mát Cross-Entropy" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="280" y="455" width="560" height="75" as="geometry" />
        </mxCell>

        <!-- Bước 5: Đánh giá thực nghiệm -->
        <mxCell id="b5" value="&lt;b&gt;5. Giao thức đánh giá &amp;amp; Kiểm thử thực nghiệm&lt;/b&gt;&lt;br&gt;• Kịch bản 1: Đánh giá chuẩn 5-Fold Cross-Validation độc lập trên Twitter15 và Twitter16&lt;br&gt;• Kịch bản 2: Kiểm thử tổng quát hóa chéo (Huấn luyện trên Twitter15 → Kiểm thử trên Twitter16)&lt;br&gt;• Kịch bản 3: Đánh giá phát hiện sớm (Early Detection) theo các mốc thời gian lan truyền" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="280" y="580" width="560" height="85" as="geometry" />
        </mxCell>

        <!-- Các mũi tên kết nối -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="b1" target="b2_left">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="b1" target="b2_right">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="b2_left" target="b3_left">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="b2_right" target="b3_right">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="b2_left" target="b3_right">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="b2_right" target="b3_left">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="b3_left" target="b4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="b3_right" target="b4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="b4" target="b5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
